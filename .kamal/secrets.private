# Secrets for the private instance, from LEAK_PRIVATE_* environment variables.
# Generate a set once with `bin/rails leak:secrets` and keep them in a
# password manager (or as repository secrets for the deploy workflow).
# Losing the ACTIVE_RECORD_ENCRYPTION_* keys makes stored narrations
# unreadable. This file only names them: NEVER put a raw secret here.

SECRET_KEY_BASE=$LEAK_PRIVATE_SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$LEAK_PRIVATE_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$LEAK_PRIVATE_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$LEAK_PRIVATE_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
POSTGRES_PASSWORD=$LEAK_PRIVATE_POSTGRES_PASSWORD
LEAK_DATABASE_PASSWORD=$LEAK_PRIVATE_POSTGRES_PASSWORD

# Optional: the LLM step (README › The LLM step). Empty means rules only,
# and abstentions go to the review queue.
LLM_PROVIDER=$LEAK_PRIVATE_LLM_PROVIDER
LLM_API_KEY=$LEAK_PRIVATE_LLM_API_KEY
LLM_MODEL=$LEAK_PRIVATE_LLM_MODEL
LLM_BASE_URL=$LEAK_PRIVATE_LLM_BASE_URL
