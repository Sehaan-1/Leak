# Secrets for the demo instance, from LEAK_DEMO_* environment variables.
# Generate a set once with `bin/rails leak:secrets` and keep them in a
# password manager (or as repository secrets for the deploy workflow).
# Losing the ACTIVE_RECORD_ENCRYPTION_* keys makes stored narrations
# unreadable. This file only names them: NEVER put a raw secret here.

SECRET_KEY_BASE=$LEAK_DEMO_SECRET_KEY_BASE
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$LEAK_DEMO_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$LEAK_DEMO_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$LEAK_DEMO_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT
POSTGRES_PASSWORD=$LEAK_DEMO_POSTGRES_PASSWORD
LEAK_DATABASE_PASSWORD=$LEAK_DEMO_POSTGRES_PASSWORD
